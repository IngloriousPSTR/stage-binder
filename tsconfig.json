{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"resolveJsonModule": true,
		"noImplicitAny": true,
		"strict": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"]
}
